---
# Site-local additions to the existing Git-ignored
# ansible/group_vars/all/bergen-proxy.yml.
# These values are examples, not verified live configuration.
# Provision a SEPARATE restricted SSH identity and host-key pinning first.
ai_proxy_tunnel_user: bergen-ai-tunnel-client
ai_proxy_tunnel_home: /var/lib/bergen-ai-tunnel
ai_proxy_ssh_config_path: /var/lib/bergen-ai-tunnel/.ssh/config
ai_proxy_ssh_alias: bergen-ai-tunnel
# Must match the existing proxy's selected source IPv4 address.
ai_proxy_source_address: 192.0.2.10

# Reuse the existing site-local reverse_proxy_allow_cidrs.
# Do not change Paperless CIDRs or create a public allow-all rule.
# reverse_proxy_allow_cidrs: [192.0.2.0/24]

# This file must never authorize activation by default.
ai_proxy_deployment_approved: false
