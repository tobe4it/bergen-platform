.venv/
*.retry
ansible/group_vars/all/vault.yml
ansible/group_vars/all/bergen-mail.yml
ansible/group_vars/all/bergen-daytrade.yml
ansible/group_vars/all/bergen-evcc.yml

# Legacy local IBM MQ lab inputs remain ignored after the lab moved to
# https://github.com/tobe4it/bergen-mq-lab. This prevents existing controller
# files from becoming accidental untracked commits during migration.
ansible/vars/mq.local.yml
ansible/vars/mq-lab.local.yml
ansible/group_vars/all/bergen-mq-lab.yml
ansible/vars/bergen-mq-*.local.yml
ansible/vars/mq-topology/
ansible/inventory.local.yml
# Site-local inventory editor backups may contain credentials or host addresses.
ansible/inventory.local.yml~
ansible/inventory.local.yml.*~
ansible/reports/
__pycache__/
*.pyc
ansible/vars/mail-tls.local.yml

# selfHOST API credentials must never be versioned
ansible/vars/selfhost-acme.local.vault.yml
ansible/vars/selfhost-acme.local.yml
ansible/vars/selfhost-acme.vault.yml
# Any number of site-local ACME instances, each with separate Vault credentials
ansible/vars/selfhost-acme-*.local.yml
ansible/vars/selfhost-acme-*.vault.yml

# Site-specific reverse proxy topology and certificate endpoints
ansible/group_vars/all/bergen-proxy.yml

# Open WebUI OIDC site settings and encrypted credentials
ansible/vars/ai-oidc.local.yml
ansible/vars/ai-oidc.vault.yml
ansible/vars/ai-oidc.vault.yml*
# Paperless site-specific credentials and recipient mappings
ansible/vars/paperless.vault.yml
ansible/vars/paperless-synology.local.yml
ansible/vars/paperless-synology.local.yml~
ansible/vars/paperless-synology.local.yml.*~
ansible/vars/paperless*.local.yml
ansible/files/paperless/synology-paperless.json
# Site-local reviewed Paperless VZDump schedule and NFS export
ansible/vars/paperless-backup.local.yml
ansible/vars/paperless-backup.local.yml~
