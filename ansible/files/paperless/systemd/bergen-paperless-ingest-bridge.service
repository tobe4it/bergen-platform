[Unit]
Description=Bergen Paperless guarded staging-to-consume bridge
Documentation=https://github.com/tobe4it/bergen-platform/pull/60
ConditionPathExists=/etc/bergen-paperless/ingest-automation.enabled
RequiresMountsFor=/srv/bergen-paperless/ingest-staging /srv/bergen-paperless/consume /srv/bergen-paperless/ingest-bridge-state

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
TimeoutStartSec=30min
ExecStart=/usr/bin/python3 /usr/local/libexec/bergen-paperless-ingest-bridge.py --commit
