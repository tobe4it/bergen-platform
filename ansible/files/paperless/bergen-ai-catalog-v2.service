[Unit]
Description=Bergen Paperless Ollama all-owner Inbox metadata catalogue (since 2026-10-01)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/bergen-platform/paperless-ai/catalog-policy-v2.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/bergen-ai-catalog-run-v2
TimeoutStartSec=900
StandardOutput=journal
StandardError=null
