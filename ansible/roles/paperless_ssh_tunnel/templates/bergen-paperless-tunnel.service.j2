# Managed by Ansible. Internal Paperless local SSH forwarding only.
# Intentionally disabled until separately approved; do not start during staging.
[Unit]
Description=Bergen Paperless private SSH backend tunnel
Documentation=man:ssh(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paperless-tunnel-client
Group=paperless-tunnel-client
WorkingDirectory=/var/lib/bergen-paperless-tunnel
UMask=0077
ExecStart=/usr/bin/ssh -N -T -4 -b {{ paperless_tunnel_proxy_ip }} -i /var/lib/bergen-paperless-tunnel/.ssh/id_ed25519 -o BatchMode=yes -o IdentitiesOnly=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o PreferredAuthentications=publickey -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/var/lib/bergen-paperless-tunnel/.ssh/known_hosts -o GlobalKnownHostsFile=/dev/null -o HostKeyAlgorithms=ssh-ed25519 -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ForwardAgent=no -o ForwardX11=no -o PermitLocalCommand=no -o ControlMaster=no -o ProxyCommand=none -o GatewayPorts=no -L 127.0.0.1:18000:127.0.0.1:8000 paperless-tunnel@{{ paperless_tunnel_backend_ip }}
Restart=on-failure
RestartSec=10
TimeoutStartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
