#!/usr/bin/env python3
"""Bergen Platform forward-papertrading market-data collector.

No third-party Python modules are required.

Primary source:
  TradingView public screener endpoint for candidate discovery, quotes, VWAP and RVOL.
Precision source:
  Yahoo Finance chart endpoint for exact 1-minute opening-range OHLCV when available.

The collector does not place trades. It emits an immutable JSON decision record that can
be consumed by the paper-trading workflow.
"""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import email.message
import fcntl
import json
import logging
import math
import os
import smtplib
import ssl
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo

LOG = logging.getLogger("bergen-daytrading")
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 BergenPlatform/1.0"


def load_config(path: str) -> dict[str, Any]:
    with open(path, "r", encoding="utf-8") as fh:
        cfg = json.load(fh)
    return cfg


def now_market(cfg: dict[str, Any]) -> dt.datetime:
    return dt.datetime.now(ZoneInfo(cfg["market_timezone"]))


def parse_clock(day: dt.date, value: str, zone: ZoneInfo) -> dt.datetime:
    t = dt.time.fromisoformat(value)
    return dt.datetime.combine(day, t, tzinfo=zone)


def sleep_until(target: dt.datetime) -> None:
    while True:
        remaining = (target - dt.datetime.now(target.tzinfo)).total_seconds()
        if remaining <= 0:
            return
        time.sleep(min(remaining, 30.0))


def http_json(
    url: str,
    *,
    method: str = "GET",
    payload: dict[str, Any] | None = None,
    timeout: int = 12,
    retries: int = 3,
) -> dict[str, Any]:
    body = None
    headers = {
        "User-Agent": USER_AGENT,
        "Accept": "application/json,text/plain,*/*",
    }
    if payload is not None:
        body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
        headers["Content-Type"] = "application/json"
    last_error: Exception | None = None
    for attempt in range(retries):
        try:
            req = urllib.request.Request(url, data=body, headers=headers, method=method)
            with urllib.request.urlopen(req, timeout=timeout) as response:
                return json.loads(response.read().decode("utf-8"))
        except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
            last_error = exc
            delay = min(2 ** attempt, 8)
            LOG.warning("HTTP attempt %s/%s failed for %s: %s", attempt + 1, retries, url, exc)
            if attempt + 1 < retries:
                time.sleep(delay)
    raise RuntimeError(f"HTTP request failed after {retries} attempts: {url}: {last_error}")


def tv_scan(
    cfg: dict[str, Any],
    columns: list[str],
    *,
    filters: list[dict[str, Any]] | None = None,
    sort_by: str | None = None,
    sort_order: str = "desc",
    limit: int = 50,
    tickers: list[str] | None = None,
) -> list[dict[str, Any]]:
    payload: dict[str, Any] = {
        "markets": ["america"],
        "symbols": {"query": {"types": []}, "tickers": tickers or []},
        "options": {"lang": "en"},
        "columns": columns,
        "range": [0, max(1, limit)],
        "filter": filters or [],
    }
    if sort_by:
        payload["sort"] = {"sortBy": sort_by, "sortOrder": sort_order}
    raw = http_json(
        cfg["tradingview_url"],
        method="POST",
        payload=payload,
        timeout=cfg["http_timeout_seconds"],
        retries=cfg["http_retries"],
    )
    rows: list[dict[str, Any]] = []
    for item in raw.get("data", []):
        values = item.get("d", [])
        row = dict(zip(columns, values))
        row["tv_symbol"] = item.get("s")
        rows.append(row)
    return rows


def discover_candidates(cfg: dict[str, Any]) -> list[dict[str, Any]]:
    columns = [
        "name",
        "description",
        "exchange",
        "premarket_close",
        "premarket_change",
        "premarket_volume",
        "market_cap_basic",
        "is_primary",
        "type",
    ]
    filters = [
        {"left": "premarket_change", "operation": "greater", "right": cfg["gap_min_pct"]},
        {"left": "premarket_volume", "operation": "greater", "right": cfg["min_premarket_volume"]},
        {"left": "premarket_close", "operation": "greater", "right": cfg["min_price_usd"]},
        {"left": "is_primary", "operation": "equal", "right": True},
        {"left": "type", "operation": "equal", "right": "stock"},
    ]
    rows = tv_scan(
        cfg,
        columns,
        filters=filters,
        sort_by="premarket_volume",
        sort_order="desc",
        limit=max(cfg["candidate_limit"] * 4, 100),
    )
    allowed = set(cfg["allowed_exchanges"])
    candidates = []
    for row in rows:
        exchange = row.get("exchange") or (row.get("tv_symbol") or "").split(":", 1)[0]
        if exchange not in allowed:
            continue
        if not row.get("tv_symbol") or row.get("premarket_close") is None:
            continue
        candidates.append(row)
        if len(candidates) >= cfg["candidate_limit"]:
            break
    return candidates


def quote_candidates(cfg: dict[str, Any], candidates: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    if not candidates:
        return {}
    columns = [
        "name",
        "close",
        "close|1",
        "high|1",
        "low|1",
        "volume|1",
        "volume",
        "VWAP",
        "VWAP|1",
        "relative_volume_10d_calc",
        "relative_volume_10d_calc|1",
    ]
    rows = tv_scan(
        cfg,
        columns,
        tickers=[c["tv_symbol"] for c in candidates],
        limit=len(candidates),
    )
    return {row["tv_symbol"]: row for row in rows if row.get("tv_symbol")}


def yahoo_symbol(tv_symbol: str) -> str:
    ticker = tv_symbol.split(":", 1)[-1]
    return ticker.replace(".", "-")


def yahoo_bars(cfg: dict[str, Any], tv_symbol: str) -> list[dict[str, Any]]:
    symbol = urllib.parse.quote(yahoo_symbol(tv_symbol), safe="-")
    params = urllib.parse.urlencode(
        {
            "interval": "1m",
            "range": "1d",
            "includePrePost": "false",
            "events": "div,splits",
        }
    )
    last_error: Exception | None = None
    for host in cfg["yahoo_hosts"]:
        url = f"https://{host}/v8/finance/chart/{symbol}?{params}"
        try:
            raw = http_json(
                url,
                timeout=cfg["http_timeout_seconds"],
                retries=cfg["http_retries"],
            )
            result = raw["chart"]["result"][0]
            stamps = result.get("timestamp") or []
            quote = (result.get("indicators", {}).get("quote") or [{}])[0]
            bars: list[dict[str, Any]] = []
            for i, stamp in enumerate(stamps):
                row = {"timestamp": int(stamp)}
                for key in ("open", "high", "low", "close", "volume"):
                    values = quote.get(key) or []
                    row[key] = values[i] if i < len(values) else None
                bars.append(row)
            if bars:
                return bars
        except Exception as exc:  # host fallback is intentional
            last_error = exc
            LOG.warning("Yahoo host %s failed for %s: %s", host, tv_symbol, exc)
    raise RuntimeError(f"Yahoo 1m unavailable for {tv_symbol}: {last_error}")


def opening_range_from_yahoo(
    cfg: dict[str, Any],
    tv_symbol: str,
    day: dt.date,
) -> dict[str, Any] | None:
    zone = ZoneInfo(cfg["market_timezone"])
    start = parse_clock(day, cfg["opening_range_start"], zone)
    end = parse_clock(day, cfg["opening_range_end"], zone)
    bars = yahoo_bars(cfg, tv_symbol)
    selected = []
    for bar in bars:
        stamp = dt.datetime.fromtimestamp(bar["timestamp"], tz=zone)
        if start <= stamp < end and bar.get("high") is not None and bar.get("low") is not None:
            selected.append((stamp, bar))
    # A 15-minute OR must contain essentially the full 15 one-minute bars.
    if len(selected) < 14:
        return None
    high = max(float(bar["high"]) for _, bar in selected)
    low = min(float(bar["low"]) for _, bar in selected)
    volume = sum(int(bar.get("volume") or 0) for _, bar in selected)
    pv = 0.0
    vv = 0
    for _, bar in selected:
        h, l, c, v = bar.get("high"), bar.get("low"), bar.get("close"), int(bar.get("volume") or 0)
        if h is None or l is None or c is None or v <= 0:
            continue
        typical = (float(h) + float(l) + float(c)) / 3.0
        pv += typical * v
        vv += v
    return {
        "high": high,
        "low": low,
        "volume": volume,
        "opening_vwap": (pv / vv) if vv else None,
        "bar_count": len(selected),
        "source": "yahoo_1m",
    }


def finite_number(value: Any) -> float | None:
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    return number if math.isfinite(number) else None


def write_json_atomic(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, ensure_ascii=False, indent=2, sort_keys=True)
        fh.write("\n")
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


def send_email(cfg: dict[str, Any], subject: str, payload: dict[str, Any]) -> None:
    mail = cfg.get("email", {})
    if not mail.get("enabled"):
        return
    if not mail.get("to"):
        LOG.warning("Email enabled, but no recipient configured")
        return
    msg = email.message.EmailMessage()
    msg["From"] = mail["from"]
    msg["To"] = mail["to"]
    msg["Subject"] = subject
    msg.set_content(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    with smtplib.SMTP(mail["smtp_host"], int(mail["smtp_port"]), timeout=15) as smtp:
        if mail.get("starttls"):
            smtp.starttls(context=ssl.create_default_context())
        if mail.get("username"):
            smtp.login(mail["username"], mail.get("password", ""))
        smtp.send_message(msg)


def run_session(cfg: dict[str, Any]) -> dict[str, Any]:
    zone = ZoneInfo(cfg["market_timezone"])
    now = dt.datetime.now(zone)
    day = now.date()
    if now.weekday() >= 5:
        return {"date": day.isoformat(), "status": "skipped", "reason": "weekend"}

    or_start = parse_clock(day, cfg["opening_range_start"], zone)
    or_end = parse_clock(day, cfg["opening_range_end"], zone)
    signal_end = parse_clock(day, cfg["signal_window_end"], zone)

    if now < or_start - dt.timedelta(minutes=2):
        sleep_until(or_start - dt.timedelta(minutes=2))

    LOG.info("Discovering pre-market candidates")
    try:
        candidates = discover_candidates(cfg)
    except Exception as exc:
        result = {
            "date": day.isoformat(),
            "status": "data_error",
            "stage": "candidate_discovery",
            "error": str(exc),
            "generated_at": dt.datetime.now(zone).isoformat(),
        }
        return result

    record: dict[str, Any] = {
        "date": day.isoformat(),
        "status": "monitoring",
        "strategy": "long_only_15m_orb_vwap_rvol",
        "generated_at": dt.datetime.now(zone).isoformat(),
        "rules": {
            "gap_min_pct": cfg["gap_min_pct"],
            "min_price_usd": cfg["min_price_usd"],
            "min_premarket_volume": cfg["min_premarket_volume"],
            "min_relative_volume": cfg["min_relative_volume"],
            "opening_range": f'{cfg["opening_range_start"]}-{cfg["opening_range_end"]}',
            "breakout_confirmations": cfg["breakout_confirmations"],
        },
        "candidates": candidates,
        "opening_ranges": {},
        "signals": [],
    }

    if not candidates:
        record["status"] = "no_trade"
        record["reason"] = "no_premarket_candidates"
        return record

    # Let the 15-minute range complete before reconstructing it from 1-minute bars.
    sleep_until(or_end + dt.timedelta(seconds=5))
    for candidate in candidates:
        symbol = candidate["tv_symbol"]
        try:
            opening = opening_range_from_yahoo(cfg, symbol, day)
        except Exception as exc:
            LOG.warning("Exact opening range unavailable for %s: %s", symbol, exc)
            opening = None
        if opening:
            record["opening_ranges"][symbol] = opening

    if not record["opening_ranges"]:
        record["status"] = "data_error"
        record["stage"] = "opening_range"
        record["reason"] = "no_exact_1m_opening_range_available"
        return record

    # Only candidates with a valid exact opening range continue to the live signal check.
    candidates = [c for c in candidates if c["tv_symbol"] in record["opening_ranges"]]
    confirmations: dict[str, int] = {c["tv_symbol"]: 0 for c in candidates}
    fired: set[str] = set()

    while dt.datetime.now(zone) < signal_end:
        try:
            quotes = quote_candidates(cfg, candidates)
        except Exception as exc:
            LOG.warning("Live quote poll failed: %s", exc)
            time.sleep(cfg["signal_poll_seconds"])
            continue
        seen_at = dt.datetime.now(zone)
        for candidate in candidates:
            symbol = candidate["tv_symbol"]
            if symbol in fired:
                continue
            q = quotes.get(symbol)
            if not q:
                confirmations[symbol] = 0
                continue
            price = finite_number(q.get("close")) or finite_number(q.get("close|1"))
            vwap = finite_number(q.get("VWAP")) or finite_number(q.get("VWAP|1"))
            rvol = finite_number(q.get("relative_volume_10d_calc")) or finite_number(q.get("relative_volume_10d_calc|1"))
            or_high = finite_number(record["opening_ranges"][symbol]["high"])
            if None in (price, vwap, rvol, or_high):
                confirmations[symbol] = 0
                continue
            condition = bool(price > or_high and price > vwap and rvol >= cfg["min_relative_volume"])
            confirmations[symbol] = confirmations[symbol] + 1 if condition else 0
            if confirmations[symbol] >= cfg["breakout_confirmations"]:
                fired.add(symbol)
                record["signals"].append(
                    {
                        "tv_symbol": symbol,
                        "ticker": candidate.get("name"),
                        "description": candidate.get("description"),
                        "signal_time": seen_at.isoformat(),
                        "price_usd": price,
                        "opening_range_high": or_high,
                        "opening_range_low": record["opening_ranges"][symbol]["low"],
                        "vwap": vwap,
                        "relative_volume": rvol,
                        "premarket_change_pct": candidate.get("premarket_change"),
                        "premarket_volume": candidate.get("premarket_volume"),
                        "source": "tradingview_live+yahoo_1m_or",
                    }
                )
        if record["signals"]:
            # The paper-trading workflow chooses among signals available at this exact time.
            break
        time.sleep(cfg["signal_poll_seconds"])

    if record["signals"]:
        record["status"] = "signal"
        # Deterministic ranking: strongest RVOL, then gap, then pre-market volume.
        record["signals"].sort(
            key=lambda s: (
                float(s.get("relative_volume") or 0),
                float(s.get("premarket_change_pct") or 0),
                float(s.get("premarket_volume") or 0),
            ),
            reverse=True,
        )
        record["selected_signal"] = record["signals"][0]
    else:
        record["status"] = "no_trade"
        record["reason"] = "no_confirmed_breakout_before_signal_window_end"

    record["completed_at"] = dt.datetime.now(zone).isoformat()
    return record


def command_self_test(cfg: dict[str, Any]) -> int:
    rows = discover_candidates(cfg)
    print(json.dumps({"candidate_count": len(rows), "candidates": rows[:5]}, indent=2, ensure_ascii=False))
    return 0


def command_run(cfg: dict[str, Any]) -> int:
    state_dir = Path(cfg["state_dir"])
    state_dir.mkdir(parents=True, exist_ok=True)
    lock_path = state_dir / ".collector.lock"
    with open(lock_path, "w", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            LOG.error("Another collector session is already running")
            return 2
        result = run_session(cfg)
        day = result.get("date", now_market(cfg).date().isoformat())
        day_dir = state_dir / day
        output = day_dir / "entry-signal.json"
        write_json_atomic(output, result)
        write_json_atomic(state_dir / "latest.json", result)
        subject = f"Bergen Daytrading {day}: {result.get('status', 'unknown')}"
        try:
            send_email(cfg, subject, result)
        except Exception:
            LOG.exception("Could not send result email")
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return 0 if result.get("status") not in {"data_error"} else 1


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", required=True)
    parser.add_argument("command", choices=["run-session", "self-test"])
    args = parser.parse_args()

    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
    )
    cfg = load_config(args.config)
    if args.command == "self-test":
        return command_self_test(cfg)
    return command_run(cfg)


if __name__ == "__main__":
    raise SystemExit(main())
