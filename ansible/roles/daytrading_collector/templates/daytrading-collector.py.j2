#!/usr/bin/env python3
"""Provider-neutral Bergen daytrading notification helper."""

from __future__ import annotations

import argparse
import email.message
import json
import smtplib
import ssl
from pathlib import Path
from typing import Any


def load_config(path: str) -> dict[str, Any]:
    with open(path, "r", encoding="utf-8") as handle:
        return json.load(handle)


def read_password(path: str) -> str:
    password = Path(path).read_text(encoding="utf-8").rstrip("\r\n")
    if not password:
        raise ValueError("SMTP password file is empty")
    return password


def send_email(cfg: dict[str, Any], subject: str, payload: dict[str, Any]) -> None:
    mail = cfg["email"]
    required = ("smtp_host", "smtp_port", "username", "password_file", "from", "to")
    missing = [key for key in required if not mail.get(key)]
    if missing:
        raise ValueError(f"Missing email configuration: {', '.join(missing)}")

    message = email.message.EmailMessage()
    message["From"] = mail["from"]
    message["To"] = mail["to"]
    message["Subject"] = subject
    message.set_content(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))

    timeout = int(mail.get("timeout_seconds", 15))
    with smtplib.SMTP(mail["smtp_host"], int(mail["smtp_port"]), timeout=timeout) as smtp:
        smtp.ehlo()
        if mail.get("starttls"):
            smtp.starttls(context=ssl.create_default_context())
            smtp.ehlo()
        smtp.login(mail["username"], read_password(mail["password_file"]))
        smtp.send_message(message)


def command_mail_test(cfg: dict[str, Any]) -> int:
    payload = {
        "status": "test",
        "message": "Mailversand vom daytrade-LXC funktioniert.",
    }
    send_email(cfg, "Bergen Daytrading - Mailtest", payload)
    print(json.dumps({**payload, "recipient": cfg["email"]["to"]}, ensure_ascii=False))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", required=True)
    parser.add_argument("command", choices=["mail-test"])
    args = parser.parse_args()

    cfg = load_config(args.config)
    return command_mail_test(cfg)


if __name__ == "__main__":
    raise SystemExit(main())
