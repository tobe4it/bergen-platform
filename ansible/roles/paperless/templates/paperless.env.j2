# Generated by Bergen Platform; root-only
PAPERLESS_URL={{ paperless_url }}
PAPERLESS_SECRET_KEY={{ vault_paperless_secret_key | to_json }}
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=bergen-paperless-db
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS={{ vault_paperless_db_password | to_json }}
PAPERLESS_REDIS=redis://bergen-paperless-redis:6379
PAPERLESS_TIME_ZONE={{ paperless_timezone }}
PAPERLESS_OCR_LANGUAGE={{ paperless_ocr_language }}
USERMAP_UID={{ paperless_uid }}
USERMAP_GID={{ paperless_gid }}
PAPERLESS_ADMIN_USER={{ paperless_admin_user }}
PAPERLESS_ADMIN_PASSWORD={{ vault_paperless_admin_password | to_json }}

# ASN recognition is independent of document splitting and path-based ACLs.
# Keep disabled until a reviewed probe scan; no recursive consumer here.
{% if paperless_scan_asn_enabled | bool %}
PAPERLESS_CONSUMER_ENABLE_ASN_BARCODE=true
PAPERLESS_CONSUMER_ASN_BARCODE_PREFIX=ASN
{% endif %}
PAPERLESS_CONSUMER_RECURSIVE=false
